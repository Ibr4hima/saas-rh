# --- Base de données ---
# Port hôte du Postgres docker (changer en 5433 si un autre Postgres occupe 5432,
# et reporter le même port dans les deux URLs ci-dessous)
DB_PORT=5432
# Rôle propriétaire (migrations uniquement — bypasse la RLS, jamais utilisé par l'app)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teranga
# Rôle applicatif non-owner (runtime — soumis à la RLS, cf. ADR-0002)
APP_DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5432/teranga

# --- API ---
PORT=3001
SESSION_TTL_HOURS=12
# Clé de chiffrement applicatif (CNI…) : 32 octets en base64.
# Valeur de DEV uniquement — générer la vôtre : openssl rand -base64 32
DATA_ENCRYPTION_KEY=mfM8qEsFfS1lIiWvm8hrM8zqi+O/PFhzPku1whgaMoU=
# En production : true (la session ne passe qu'en HTTPS, cookie __Host-).
# L'API refuse de démarrer en production sans HTTPS.
COOKIE_SECURE=false
# Derrière un reverse proxy (Cloudflare, Coolify…) : les proxys dont l'API
# croit l'en-tête X-Forwarded-For, pour lire l'adresse du client et non
# celle du proxy (anti-abus des candidatures et des connexions). Un nombre
# de sauts (2) ou une liste d'adresses et de réseaux (loopback, 10.0.0.0/8).
# 'false' si l'API est exposée directement. Obligatoire en production.
TRUST_PROXY=
# Inscription publique (création d'une organisation depuis /register) : fermée
# hors base vide. À ouvrir en développement pour rejouer scripts/seed-demo.mjs
# sur une base qui a déjà des comptes ; jamais en production.
INSCRIPTION_OUVERTE=false
# Adresse publique du site : c'est elle que porte le QR code des certificats
# APIX Academy (page /verifier/APX-…), et la seule origine autorisée à
# appeler l'API avec une session. En https:// en production.
PUBLIC_WEB_URL=http://localhost:3002
# D'autres origines autorisées, séparées par des virgules (https:// en
# production). Aucune par défaut.
CORS_ORIGINS=

# --- Courriels ---
# Par défaut : Mailpit en développement (pnpm mail:up, lecture sur
# http://localhost:8025), rien ailleurs. Les tests n'envoient jamais rien.
#   smtp  : un serveur SMTP (Mailpit, ou autre)
#   graph : Microsoft 365, par l'API Microsoft Graph (production APIX)
#   aucun : rien ne part ; la DCH transmet le lien d'invitation elle-même
# MAIL_TRANSPORT=smtp
MAIL_FROM=Capital Humain <rh@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Microsoft 365 : une application enregistrée dans Entra ID, permission
# d'application Mail.Send, limitée à la boîte qui envoie par une stratégie
# d'accès (New-ApplicationAccessPolicy ou RBAC for Applications).
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=rh@apix.sn
